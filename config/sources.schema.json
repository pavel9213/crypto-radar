{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Crypto Radar source configuration",
  "description": "Project sources consumed by scripts/collect_news.py.",
  "type": "object",
  "required": ["projects", "poll_interval_hours", "max_events"],
  "properties": {
    "poll_interval_hours": {"type": "integer", "minimum": 1, "maximum": 24},
    "max_events": {"type": "integer", "minimum": 1, "maximum": 5000},
    "projects": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "name", "keywords", "official_urls", "official_domains", "x_handles"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
          "name": {"type": "string", "minLength": 1},
          "keywords": {"type": "array", "items": {"type": "string", "minLength": 1}},
          "official_urls": {"type": "array", "items": {"type": "string", "format": "uri"}},
          "official_domains": {"type": "array", "items": {"type": "string", "minLength": 1}},
          "x_handles": {"type": "array", "items": {"type": "string", "pattern": "^[A-Za-z0-9_]{1,15}$"}}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
